# Copy to backend/.env and replace these placeholders with your own values.
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/tuneflow?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
IMAGEKIT_PRIVATE_KEY=replace-with-your-imagekit-private-key

# Optional: set only if your network's default DNS refuses Atlas SRV lookups.
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
